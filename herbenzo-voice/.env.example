# Stage F (herbenzo-voice) — copy to the ambient-healthcare-agents repo-root .env
# (already git-ignored) and fill in secrets. Never commit real values.
# Ports: agent :8081, voice :7860. Stage A recommender default :8000.
#
# Federation keys also used elsewhere (see glue SECRETS.md):
#   NVIDIA_API_KEY, ANTHROPIC_API_KEY, GEMINI/GOOGLE, NCBI (N/A on F),
#   PIPELINE_MODE (F), PIPELINE_TRUST (C only).

ENV=dev

# --- Provider credentials (env / this gitignored file only; never commit real values) ---
# GOOGLE_API_KEY is what gemini_live reads. GEMINI_API_KEY is not read here.
GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
NVIDIA_API_KEY=
# NGC_API_KEY=            # only for self-hosted NIM containers
# ANTHROPIC_API_KEY=
# NCBI_API_KEY=           # not used by F

# --- LLM (gemini_live default; nvidia | anthropic | google | fake still selectable) ---
# LLM_PROVIDER sets every role that does not set LLM_<ROLE>_PROVIDER.
LLM_PROVIDER=gemini_live
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Text roles (extractor, responder, red flag) use generateContent, not a Live session.
# GEMINI_TEXT_MODEL is the default for every role that does not set LLM_<ROLE>_MODEL.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_THINKING_LEVEL=low
# GEMINI_LIVE_SILENCE_MS=500
# GEMINI_LIVE_LISTEN_TIMEOUT_S=20
# GEMINI_LIVE_SPEAK_TIMEOUT_S=30
# LLM_EXTRACTOR_PROVIDER=gemini_live
# LLM_EXTRACTOR_MODEL=gemini-3.8-flash
# LLM_RESPONDER_PROVIDER=gemini_live
# LLM_RESPONDER_MODEL=gemini-3.8-flash
# LLM_RED_FLAG_PROVIDER=gemini_live
# LLM_RED_FLAG_MODEL=gemini-3.8-flash
# Original NVIDIA models: LLM_PROVIDER=nvidia and set NVIDIA_API_KEY.
# LLM_EXTRACTOR_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_DISABLE_THINKING=true

# --- Guardrails (auto: deterministic with Gemini, NemoGuard when every role is nvidia) ---
# GUARDRAILS_BACKEND=auto
# GUARDRAILS_BACKEND=nemo            # optional NVIDIA NemoGuard path
# GUARDRAILS_BACKEND=deterministic   # blocked terms + injection checks, no NVIDIA endpoint
GUARDRAILS_ENABLED=true
GUARDRAILS_CONFIG_PATH=herbenzo_agent/guardrails/herbenzo-intake-nemoguard
GUARDRAILS_BASE_URL=https://integrate.api.nvidia.com/v1
GUARDRAILS_TIMEOUT_S=3
GUARDRAILS_TOPIC_CONTROL=false
GUARDRAILS_OUTPUT_ENABLED=true

# --- Storage ---
DATABASE_URL=sqlite:///data/herbenzo_voice.db

# --- Service security (generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))") ---
INTERNAL_API_TOKEN=
ADMIN_API_TOKEN=
# Prod profile (ENV=prod): required on POST /v1/chat as header X-Chat-Token.
# Localhost demo profile (ENV=dev, default): leave unset; /v1/chat stays open behind rate limits.
CHAT_BOOTSTRAP_TOKEN=
# Override auto rule (auto = required only when ENV=prod). Examples:
#   CHAT_AUTH_REQUIRED=true   # force token even in ENV=dev
#   CHAT_AUTH_REQUIRED=false  # never require (not for prod)
# CHAT_AUTH_REQUIRED=
CORS_ALLOW_ORIGINS=["https://localhost"]

# --- Handoff to Stage A Recommender ---
RECOMMENDER_URL=http://localhost:8000
RECOMMENDER_TIMEOUT_S=600
HANDOFF_ENABLED=true
HANDOFF_MIN_CONFIDENCE=0.5
# PIPELINE_MODE=true (default): /ready returns 503 when Stage A is down;
# unavailable NemoGuard / content-safety input rails fail closed (turn rejected).
# Set false for intake-only demo: /ready ignores A; guardrails fail open on unavailable.
PIPELINE_MODE=true

# --- Intake policy ---
MIN_ADULT_AGE=18
MAX_USER_TURNS=30
AYURVEDIC_CONTEXT_ENABLED=true
# Ceiling for the responder phrase() call. On timeout the slot's scripted question is spoken.
RESPONDER_TIMEOUT_S=6
DEFAULT_LANGUAGE=en-IN
DEFAULT_JURISDICTION=IN
TRANSCRIPT_RETENTION_DAYS=90

# --- Logging ---
LOG_LEVEL=INFO
LOG_CONTENT=false

# --- Voice controller ---
VOICE_CONFIG_PATH=configs/riva_public.yaml   # or configs/riva_self_hosted.yaml
AGENT_URL=http://localhost:8081
VOICE_ALLOWED_ORIGINS=http://localhost:4400
ENABLE_SPECULATIVE_SPEECH=false             # keep false: the agent keeps conversation memory
DUMP_AUDIO_FILES=false
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- Web front door (docker compose) ---
SITE_ADDRESS=localhost        # public domain in production
CADDY_TLS=tls internal        # set to an empty comment ("#") for automatic public certificates
